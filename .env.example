APP_NAME=Moduhub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_PORT=8080
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6379
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=moduhub
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NFS-e: http (Sefin Nacional com o certificado do emitente) ou fake (simulado, sem e-CNPJ)
INVOICES_SEFIN_DRIVER=http
INVOICES_SEFIN_TIMEOUT=30

# Selo ICP-Brasil da plataforma: e-CNPJ A1 aplicado em todo documento concluído.
# Sem senha o selo fica desligado. Em produção, aponte o caminho para fora da pasta do app.
# SIGNATURES_PLATFORM_CERT_PATH=/etc/moduhub/moduhub.pfx
SIGNATURES_PLATFORM_CERT_PASSWORD=

# Chave dos certificados digitais guardados no banco (.pfx e senha dos emitentes), separada da APP_KEY.
# Gere com: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Na troca, a chave antiga vai para CERTIFICATES_ENCRYPTION_PREVIOUS_KEYS (separadas por vírgula).
CERTIFICATES_ENCRYPTION_KEY=
CERTIFICATES_ENCRYPTION_PREVIOUS_KEYS=
